# =============================================================================
# Backend (Node/Express) — environment variables
# Copy this file to `.env` in the backend/ folder and fill in real values.
# Never commit the real .env file — it holds database and JWT secrets.
# =============================================================================

# Port the Express API listens on. The frontend's VITE_API_BASE_URL must
# point at this port (e.g. http://localhost:4000/api).
PORT=4000

# --- MySQL connection -------------------------------------------------------
# Host where MySQL is running. Use "localhost" for local dev, or the
# database container/service name when running under docker-compose (e.g. "db").
DB_HOST=localhost

# MySQL port. Default is 3306 — only change this if your MySQL instance
# listens elsewhere.
DB_PORT=3306

# MySQL username. "root" works for local dev; use a dedicated least-privilege
# user in production.
DB_USER=root

# MySQL password for DB_USER. Set this to your own value — do not reuse the
# example below in any real deployment.
DB_PASSWORD=peanut$

# Name of the database created by database/schema.sql.
DB_NAME=electronics_manufacturing_db

# Max simultaneous connections in the MySQL connection pool. 10 is a
# reasonable default for a small deployment; raise it under heavier load.
DB_CONNECTION_LIMIT=10

# --- Auth --------------------------------------------------------------------
# Secret used to sign JWTs. MUST be a long, random, unguessable string in
# production — generate one with: openssl rand -hex 32
JWT_SECRET=replace-this-with-a-long-random-string

# How long a login session stays valid before the user must log in again.
# Accepts values like "1h", "12h", "7d".
JWT_EXPIRES_IN=12h

# bcrypt hashing cost. 10 is a good default; higher is slower but more
# resistant to brute-forcing. Don't go below 10.
BCRYPT_SALT_ROUNDS=10

# --- ML service ---------------------------------------------------------------
# Base URL of the Python ML service (see ml-service/.env.example). The
# backend calls this for production/quality/failure-risk/anomaly predictions.
ML_SERVICE_URL=http://localhost:8000

# Milliseconds to wait for the ML service before giving up on a prediction
# request. AI Insights and equipment detail pages degrade gracefully (they
# just omit the ML-derived insight) if this times out.
ML_SERVICE_TIMEOUT_MS=5000

# --- CORS ----------------------------------------------------------------------
# Comma-separated list of origins allowed to call this API. Set this to your
# deployed frontend's URL in production (e.g. https://app.example.com).
# Use http://localhost:5173 for the Vite dev server during local development.
CORS_ORIGINS=http://localhost:5173
