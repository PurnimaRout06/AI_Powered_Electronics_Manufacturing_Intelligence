# =============================================================================
# Frontend (Vite/React) — environment variables
# Copy this file to `.env` in the manufacturing-intelligence/ folder.
# Vite only exposes variables prefixed with VITE_ to the browser.
# =============================================================================

# Base URL of the backend API (see backend/.env.example — must match its
# PORT). Include the /api prefix, since every backend route is mounted there.
VITE_API_BASE_URL=http://localhost:4000/api

# When "true", every service call resolves from local mock data
# (src/data/mockData.js) instead of the backend — useful for running the UI
# standalone without the database/backend/ML service running. Leave "false"
# (or unset) to use the real backend.
VITE_USE_MOCKS=false

# Base URL of your Grafana instance (see src/config/grafanaDashboards.js).
# The 7 public-dashboard UIDs from the "Dashboards and panels links" doc are
# appended to this. Change this if Grafana isn't running on localhost:3000
# (e.g. a deployed Grafana behind its own domain).
VITE_GRAFANA_BASE_URL=http://localhost:3000
