# =============================================================================
# ML Service — environment variables
# Copy this file to `.env` in the ml-service/ folder and fill in real values.
# =============================================================================

# Absolute or relative path to the folder containing the four .pkl model
# files (production_model.pkl, quality_rejection_model.pkl,
# failure_risk_model.pkl, anomaly_detection_model.pkl). Copy them here from
# the original project's data-ml/models/ folder before starting the service.
MODELS_DIR=./models

# Comma-separated list of origins allowed to call this service directly.
# In production this should just be the Node backend's origin, since the
# frontend never calls the ML service directly. Use "*" only for local dev.
CORS_ORIGINS=http://localhost:4000

# Port uvicorn listens on. Match this to ML_SERVICE_URL in the backend's .env.
PORT=8000
